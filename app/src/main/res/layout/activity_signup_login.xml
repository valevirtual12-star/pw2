<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_signup"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Espaciador superior -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Logo de la aplicación -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="Logo Alke Wallet"
        android:src="@drawable/baseline_account_balance_wallet_24" />

    <!-- Nombre de la aplicación -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Alke Wallet"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Espaciador central -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Botón Principal: Crear nueva cuenta -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCreateAccount"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/btn_rounded_celeste"
        android:text="Crear nueva cuenta"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Botón Secundario: Ya tiene cuenta -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAlreadyHaveAccount"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:background="@android:color/transparent"
        android:text="Ya tiene cuenta"
        android:textAllCaps="false"
        android:textColor="@color/celeste_wallet"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>